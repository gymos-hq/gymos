    "fastify": "^4.27.0"
  },
  "devDependencies": {
    "@gymos/eslint-config": "*",
    "@types/node": "^20.12.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
